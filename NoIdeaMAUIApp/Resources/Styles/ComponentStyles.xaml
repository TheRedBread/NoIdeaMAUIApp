<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Border" x:Key="PlayButtonBorder">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchMin}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchMin}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource RadiusPill}" />
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>