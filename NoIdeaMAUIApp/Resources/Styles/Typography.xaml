<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Display -->
    <x:String x:Key="DisplayFontFamily">LiterataSemiBold</x:String>
    <x:Double x:Key="DisplayFontSize">32</x:Double>
    <x:Double x:Key="DisplayLineHeight">1.185</x:Double>

    <!-- Title -->
    <x:String x:Key="TitleFontFamily">LiterataSemiBold</x:String>
    <x:Double x:Key="TitleFontSize">24</x:Double>
    <x:Double x:Key="TitleLineHeight">1.25</x:Double>

    <!-- Heading -->
    <x:String x:Key="HeadingFontFamily">LiterataSemiBold</x:String>
    <x:Double x:Key="HeadingFontSize">20</x:Double>
    <x:Double x:Key="HeadingLineHeight">1.3</x:Double>

    <!-- Body -->
    <x:String x:Key="BodyFontFamily">PlexSans</x:String>
    <x:Double x:Key="BodyFontSize">16</x:Double>
    <x:Double x:Key="BodyLineHeight">1.5</x:Double>

    <!-- Label -->
    <x:String x:Key="LabelFontFamily">PlexSansMedium</x:String>
    <x:Double x:Key="LabelFontSize">14</x:Double>
    <x:Double x:Key="LabelLineHeight">1.4286</x:Double>

    <!-- Caption -->
    <x:String x:Key="CaptionFontFamily">PlexSans</x:String>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="CaptionLineHeight">1.3333</x:Double>

    <!-- Numeric -->
    <x:String x:Key="NumericFontFamily">PlexMonoMedium</x:String>
    <x:Double x:Key="NumericFontSize">24</x:Double>

</ResourceDictionary>