<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="LiterataSemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="1.185" />
    </Style>
    
    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="LiterataSemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>
    
    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="LiterataSemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>
    
    <Style x:Key="LabelText" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSansMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.4286" />
    </Style>
    
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSans" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.3333" />
    </Style>
    
    <Style x:Key="Numeric" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexMonoMedium" />
        <Setter Property="FontSize" Value="24" />
    </Style>
    
</ResourceDictionary>