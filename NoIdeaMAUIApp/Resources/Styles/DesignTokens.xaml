<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="RadiusXS">4</x:Double>
    <x:Double x:Key="RadiusSM">8</x:Double>
    <x:Double x:Key="RadiusMD">12</x:Double>
    <x:Double x:Key="RadiusLG">20</x:Double>
    <x:Double x:Key="RadiusPill">999</x:Double>

    <Shadow
    x:Key="ShadowNone"
    Brush="Black"
    Offset="0,0"
    Radius="0"
    Opacity="0" />
    <Shadow
    x:Key="ShadowSM"
    Brush="Black"
    Offset="0,1"
    Radius="2"
    Opacity="0.08" />
    <Shadow
    x:Key="ShadowMD"
    Brush="Black"
    Offset="0,6"
    Radius="16"
    Opacity="0.14" />

    <x:Double x:Key="SpaceXXS">4</x:Double>
    <x:Double x:Key="SpaceXS">8</x:Double>
    <x:Double x:Key="SpaceSM">16</x:Double>
    <x:Double x:Key="SpaceMD">24</x:Double>
    <x:Double x:Key="SpaceLG">32</x:Double>
    <x:Double x:Key="SpaceXL">48</x:Double>

    <x:Double x:Key="TouchMin">44</x:Double>
    
    <x:String x:Key="IconFontFamily">Lucide</x:String>
    <x:Double x:Key="IconSize">24</x:Double>
    <x:Double x:Key="IconStrokeWidth">1.75</x:Double>
    
</ResourceDictionary>