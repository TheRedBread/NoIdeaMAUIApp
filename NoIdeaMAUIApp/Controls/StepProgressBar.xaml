<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoIdeaMAUIApp.Controls.StepProgressBar">
    <HorizontalStackLayout Spacing="6" Padding="0,8" BackgroundColor="Red">
        <BoxView
            HeightRequest="4"
            WidthRequest="150"
            CornerRadius="2"
            Color="{StaticResource Accent}" />
        <BoxView
            HeightRequest="4"
            WidthRequest="150"
            CornerRadius="2"
            Color="{StaticResource Border}" />
    </HorizontalStackLayout>
</ContentView>