<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoIdeaMAUIApp.Views.YourDaysFilled"
             xmlns:controls="clr-namespace:NoIdeaMAUIApp.Controls"
             Title="YourDaysFilled">
    <Grid RowDefinitions="*,Auto">
        <controls:GridBackground />
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25"
                HorizontalOptions="Fill">
                <controls:toppart/>
                <Grid ColumnDefinitions="*,*,*"
                    HorizontalOptions="Fill">
                    <Border Style="{StaticResource Card}"
                            HorizontalOptions="Fill"
                            Grid.Column="0">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="pod rząd"
                                   Style="{StaticResource Caption}"/>
                            <HorizontalStackLayout
                                HorizontalOptions="Fill"
                                Spacing="10">
                                <Label Text="5"
                                       Style="{StaticResource Heading}"/>
                                <Label Text="dni"
                                       Style="{StaticResource Caption}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}"
                            HorizontalOptions="Fill"
                            Grid.Column="1">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="łącznie"
                                   Style="{StaticResource Caption}"/>
                            <HorizontalStackLayout HorizontalOptions="Fill"
                                Spacing="10">
                                <Label Text="143"
                                       Style="{StaticResource Heading}"/>
                                <Label Text="dni"
                                       Style="{StaticResource Caption}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}"
                            HorizontalOptions="Fill"
                            Grid.Column="2">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="pierwszy dzień"
                                   Style="{StaticResource Caption}"/>
                            <Label Text="04.03"
                                   Style="{StaticResource Heading}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dzisiaj"
                               Style="{StaticResource Heading}"/>
                        <Label Text="Rano 104, wieczorem spacer. Pogoda taka, że aż chciało się wyjść."
                               Style="{StaticResource Body}"/>
                        <HorizontalStackLayout>
                            <Border Style="{StaticResource PillBorder}">
                                <Label Text="104 mg/dl"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Accent}"/>
                            </Border>
                            <Border Style="{StaticResource PillBorder}"
                                    BackgroundColor="{StaticResource Gray100}">
                                <Label Text="0:47 audo"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Gray600}"/>
                            </Border>
                            <Border Style="{StaticResource ImageBorder}"
                                    HorizontalOptions="Fill"
                                    MaximumHeightRequest="45"
                                    MaximumWidthRequest="45">
                                <Image Source="imgmaui.png" Aspect="AspectFill"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,auto">
                            <Label Text="Wczoraj"
                                   Style="{StaticResource Heading}"/>
                            <Label Text="pon 14.09"
                                   Style="{StaticResource Caption}"
                                   Grid.Column="1"/>
                        </Grid>
                        <Label Text="Wieczorem znów spadek po treningu. Następny raz zjem coś przed, nie po."
                               Style="{StaticResource Body}"/>
                        <HorizontalStackLayout>
                            <Border Style="{StaticResource PillBorder}"
                                    BackgroundColor="#D08A5A">
                                <Label Text="187 mg/dl"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Warning}"/>
                            </Border>
                            <Border Style="{StaticResource PillBorder}"
                                    BackgroundColor="{StaticResource Gray100}">
                                <Label Text="84,7KG"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Gray600}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,auto">
                            <Label Text="niedziela"
                                   Style="{StaticResource Heading}"/>
                            <Label Text="13.09"
                                   Style="{StaticResource Caption}"
                                   Grid.Column="1"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8"
                              HorizontalOptions="Fill">
                            <Border Grid.Column="0"
                                    Style="{StaticResource ImageBorder}"
                                    HorizontalOptions="Fill">
                                <Image Source="imgmaui.png" Aspect="AspectFill"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource ImageBorder}"
                                    HorizontalOptions="Fill">
                                <Image Source="imgmaui.png" Aspect="AspectFill"/>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource ImageBorder}"
                                    BackgroundColor="{StaticResource Accent}"
                                    HorizontalOptions="Fill">
                                <Label Style="{StaticResource Body}"
                                       TextColor="{StaticResource Bg}"
                                       Text="+4"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Label Text="Galeria z wyjazdu - bez notki"
                               Style="{StaticResource Caption}"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*,*">
                    <BoxView HeightRequest="2"
                             HorizontalOptions="Fill"
                             Grid.Column="0"
                             Color="{StaticResource Border}"/>
                    <Label Text="2 dni bez zapisu"
                           Style="{StaticResource Body}"
                           Grid.Column="1"
                           HorizontalOptions="Center"/>
                    <BoxView HeightRequest="2"
                             HorizontalOptions="Fill"
                             Grid.Column="2"
                             Color="{StaticResource Border}"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <controls:navbar Grid.Row="1"/>
    </Grid>
</ContentPage>