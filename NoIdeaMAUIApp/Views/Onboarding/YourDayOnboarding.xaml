<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoIdeaMAUIApp.Views.Onboarding.YourDayOnboarding"
             xmlns:controls="clr-namespace:NoIdeaMAUIApp.Controls"
             Title="YourDayOnboarding">

    <Grid>
        <controls:GridBackground />
        <Grid
            Padding="24,16,24,24"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="{StaticResource SpaceSM}">

            <VerticalStackLayout>
                <Label
                    Text="HMM STATICA"
                    TextColor="{StaticResource TextMuted}"
                    Style="{StaticResource Caption}"/>
                <Label
                    Text="Twój dzień — prowadzisz jak chcesz."
                    Style="{StaticResource Title}"/>
                <Label
                    Text="Dla nas liczy się dzień. Możesz wpisać jedno zdanie, nagrać głosówkę, wrzucić zdjęcie albo całą galerię, dodać pomiar — albo nie zapisać nic. Każdy dzień to jeden zapis, nawet jeśli jest w nim tylko przecinek."
                    TextColor="{StaticResource TextMuted}"
                    Style="{StaticResource Body}"/>

                <Border Style="{StaticResource Card}"
                    HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="wtorek, 15 września"
                            TextColor="{StaticResource TextMuted}"
                            Style="{StaticResource Caption}"/>

                        <Label
                            Text="Rano 104, wieczorem spacer. Pogoda taka, że aż chciało się wyjść."
                            Style="{StaticResource Body}"/>

                        <Grid ColumnSpacing="8"
                            HorizontalOptions="Fill">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource ImageBorder}"
                                HorizontalOptions="Fill">
                                <Image Source="imgmaui.png" Aspect="AspectFill"/>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource ImageBorder}"
                                HorizontalOptions="Fill">
                                <Image Source="imgmaui.png" Aspect="AspectFill"/>
                            </Border>

                            <Border
                                Grid.Column="2"
                                Style="{StaticResource ImageBorder}"
                                HorizontalOptions="Fill"
                                BackgroundColor="{StaticResource Accent}">
                                <Label
                                    Style="{StaticResource Body}"
                                    TextColor="{StaticResource Bg}"
                                    Text="+3"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            HorizontalOptions="Fill"
                            Grid.Column="1"
                            Color="{StaticResource Border}"/>

                        <Grid 
                            ColumnSpacing="10"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Style="{StaticResource PlayButtonBorder}">
                                <ImageButton
                                    Source="playicon.png"/>
                            </Border>
                            <BoxView
                                HeightRequest="2"
                                HorizontalOptions="Fill"
                                Grid.Column="1"
                                Color="{StaticResource Border}"/>
                            <Label
                                VerticalOptions="Center"
                                Text="0:36"
                                Grid.Column="2"
                                TextColor="{StaticResource TextMuted}"
                                Style="{StaticResource Caption}"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource SpaceXS}">

                <Button
                    Text="Dalej"
                    HeightRequest="52"
                    FontFamily="{StaticResource LabelFontFamily}"/>

                <Button
                    Style="{StaticResource TextButton}"
                    Text="Mam już konto"
                    TextColor="{StaticResource TextMuted}"
                    FontFamily="{StaticResource LabelFontFamily}"
                    FontSize="{StaticResource BodyFontSize}"/>

            </VerticalStackLayout>
        </Grid>
    </Grid>
    
</ContentPage>