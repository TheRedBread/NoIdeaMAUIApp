<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NoIdeaMAUIApp.Controls"
             x:Class="NoIdeaMAUIApp.Views.MainPage">


    <Grid>
        <controls:GridBackground />
        <ScrollView>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">
                <Label
                    Text="HMM STATICA"
                    TextColor="{StaticResource TextMuted}"
                    Style="{StaticResource Caption}"/>
                <Label
                    Text="Twój dzień — prowadzisz jak chcesz."
                    Style="{StaticResource Title}"/>
                <Label
                    Text="Dla nas liczy się dzień. Możesz wpisać jedno zdanie, nagrać głosówkę, wrzucić zdjęcie albo całą galerię, dodać pomiar — albo nie zapisać nic. Każdy dzień to jeden zapis, nawet jeśli jest w nim tylko przecinek."
                    TextColor="{StaticResource TextMuted}"
                    Style="{StaticResource Label}"/>
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="Button"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
