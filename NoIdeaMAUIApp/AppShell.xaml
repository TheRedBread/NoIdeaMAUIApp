<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NoIdeaMAUIApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NoIdeaMAUIApp"
    xmlns:views="clr-namespace:NoIdeaMAUIApp.Views"
    xmlns:views.onboarding="clr-namespace:NoIdeaMAUIApp.Views.Onboarding"
    Title="NoIdeaMAUIApp">

    <TabBar>
        <Tab Title="MotivationOnboarding">
            <ShellContent ContentTemplate="{DataTemplate views.onboarding:MotivationOnboarding}" />
        </Tab>
        <Tab Title="reasonOnboarding">
            <ShellContent ContentTemplate="{DataTemplate views.onboarding:reasonOnboarding}" />
        </Tab>
        <Tab Title="YourDayOnboarding">
            <ShellContent ContentTemplate="{DataTemplate views.onboarding:YourDayOnboarding}" />
        </Tab>
        <Tab Title="YourDaysEmpty">
            <ShellContent ContentTemplate="{DataTemplate views:YourDaysEmpty}" />
        </Tab>
        <Tab Title="YourDaysFilled">
            <ShellContent ContentTemplate="{DataTemplate views:YourDaysFilled}" />
        </Tab>
    </TabBar>

</Shell>
